#!/usr/bin/env bash
# .githooks/pre-push — thin per-repo shim; ALL logic lives in the canonical core.
# Enable once: git config core.hooksPath .githooks
set -euo pipefail

export TEST_GATE="scripts/test-gate.sh"      # the repo's single test entry point (wraps `make lint`)
export EXTRA_GATES=""                        # no static gates yet
export FAST_PATH_PREFIXES="docs/:*.md"       # EXCLUSIVE touch of these skips TEST_GATE (docs lane)
export ALWAYS_TEST=".githooks/:dev-cycle-profile.yml:Makefile"  # veto the fast path
export SKIP_TESTS_ENV="KCNA_SKIP_TESTS"      # the repo's explicit skip var (loudly honored)
# export CHANGELOG_CMD="claude -p"           # any LLM CLI reading the prompt on stdin
# export CHANGELOG_AI_AUTHOR="Claude <noreply@anthropic.com>"

core="$HOME/.claude/scripts/prepush-core.sh"
if [ ! -x "$core" ]; then
  echo "✋ pre-push: canonical core missing — install ~/.claude/scripts/prepush-core.sh" >&2
  exit 1
fi
exec "$core" "$@"   # stdin (the pushed-refs protocol) passes through
